<h1>Sign Up</h1>

<%= button_to "Back", root_path, method: :get %>

<%= form_with model: @user, url: users_path do |f| %>
  <% if @user.errors.any? %>
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :username, "Username" %>
    <%= f.text_field :username %>
  </div>

  <div>
    <%= f.label :display_name, "Display name" %>
    <%= f.text_field :display_name %>
  </div>

  <div>
    <%= f.label :date_of_birth, "Date of birth" %>
    <%= f.date_field :date_of_birth %>
  </div>

  <div>
    <%= f.label :skill_level, "Skill level" %>
    <%= f.select :skill_level,
          User.skill_levels.keys.map { |k| [k.capitalize, k] } %>
  </div>

  <div>
    <%= f.label :password, "Password" %>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Password confirmation" %>
    <%= f.password_field :password_confirmation %>
  </div>

  <%= f.submit "Create account" %>
<% end %>